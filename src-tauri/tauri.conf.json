{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalFace",
  "version": "1.0.2",
  "identifier": "com.fuxiangming.localface",
  "build": {
    "frontendDist": "../desktop-dist",
    "beforeDevCommand": "node scripts/build-desktop.mjs && node scripts/prepare-sidecar.mjs",
    "beforeBuildCommand": "node scripts/build-desktop.mjs"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalFace",
        "url": "splash.html",
        "width": 1280,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/localface-server"],
    "resources": {
      "sidecar/server/": "server/",
      "resources/static/": "static/",
      "resources/models/": "models/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
