{
  "name": "localface",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "setup": "node scripts/download-models.mjs",
    "postinstall": "node scripts/download-models.mjs || echo \"模型下载失败，可稍后运行 npm run setup 重试（启动时也会自动重试）\"",
    "import": "node --disable-warning=ExperimentalWarning import-photos.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/prepare-sidecar.mjs && tauri build && node scripts/verify-bundle.mjs",
    "desktop:verify": "node scripts/verify-bundle.mjs",
    "desktop:sidecar": "node scripts/prepare-sidecar.mjs"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.19.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "LocalFace：本地多人物人脸识别桌面应用，画面不出本机",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuxm0818/localface.git"
  },
  "homepage": "https://github.com/fuxm0818/localface#readme",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
